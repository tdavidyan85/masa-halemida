{
  "name": "masa-db",
  "private": true,
  "type": "module",
  "description": "Database migrations and RLS security tests. Tests run on a throwaway local PostgreSQL – never on a cloud project.",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "local:start": "SUPABASE_EXPERIMENTAL_STACK=1 supabase start --workdir .. --experimental",
    "local:stop": "SUPABASE_EXPERIMENTAL_STACK=1 supabase stop --workdir .. --experimental",
    "test:local": "node tests/run-local.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "embedded-postgres": "^17.11.0-beta.19",
    "pg": "^8.23.1",
    "supabase": "^3.1.0"
  }
}
