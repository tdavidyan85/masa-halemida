# Copy to .env.local to change. Without changes the portal runs in DEMO mode with fictional data only.
VITE_DATA_SOURCE=mock
# simulated network delay for the demo, so loading states are visible (0 = none)
VITE_MOCK_DELAY_MS=350

# ---- server mode (development only; refused unless every value is valid) ----
# VITE_DATA_SOURCE=supabase
# VITE_SUPABASE_ENV=local                       # local = `supabase start` on this machine · dev = a separate cloud DEV project
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<the PUBLIC anon / publishable key printed by `supabase start`>
#
# Never put a service-role / secret key here: everything under VITE_ ends up in the browser.
# The live site's project (gwfacvvmlrkmfkstqpkb) is refused on purpose.
