# Copy to .env.local to change. The portal runs with local fictional data only.
VITE_DATA_SOURCE=mock
# simulated network delay for the demo, so loading states are visible (0 = none)
VITE_MOCK_DELAY_MS=350

# Reserved for the future backend – NOT used yet, leave empty. Never put a service-role key here:
# everything under VITE_ ends up in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
